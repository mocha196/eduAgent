      "title": "Errors (last 1h)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({level=\"error\"}[1h]))",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
