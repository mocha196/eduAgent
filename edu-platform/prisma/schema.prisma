generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MaterialStatus {
  UPLOADED
  PARSING
  PARSED
  INDEXING
  READY
  FAILED
}

enum MaterialPreviewPdfStatus {
  NA
  PENDING
  READY
  FAILED
}

enum AssignmentStatus {
  GENERATING
  FAILED
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  GRADING
  GRADED
  RETURNED
}

enum GradeSource {
  AUTO
  AI
  TEACHER
}

enum NotificationType {
  MATERIAL_UPLOADED
  MATERIAL_READY
  ASSIGNMENT_GENERATED
  ASSIGNMENT_FAILED
  ASSIGNMENT_PUBLISHED
  SUBMISSION_RECEIVED
  GRADE_RETURNED
  MEMORY_REVIEW_READY
}

enum MemoryReviewSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
  EXPIRED
}

enum MemoryReviewQuestionType {
  SINGLE_CHOICE
  FILL_BLANK
  TRUE_FALSE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @map("username")
  email        String   @unique @map("email")
  passwordHash String   @map("password_hash")
  role         UserRole @map("role")
  realName     String?  @map("real_name")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isActive     Boolean  @default(true) @map("is_active")

  /// When false, chat still works but QaLog rows are not created (B3 privacy).
  qaCollectionEnabled            Boolean   @default(true) @map("qa_collection_enabled")
  qaCollectionNoticeAcceptedAt   DateTime? @map("qa_collection_notice_accepted_at")

  refreshTokens       RefreshToken[]
  teacherCourses      Course[]             @relation("TeacherCourses")
  courseEnrollments   CourseEnrollment[]   @relation("StudentEnrollments")
  qaLogs                    QaLog[]                    @relation("QaLogStudent")
  courseChatSessions        CourseChatSession[]
  qaCenterSessions          QaCenterSession[]
  chatThreadTitleOverrides  ChatThreadTitleOverride[]
  assignments               Assignment[]
  submittedAssignments      AssignmentSubmission[]  @relation("StudentSubmissions")
  learningProfile           UserLearningProfile?
  memoryFacts               UserMemoryFact[]
  memoryConcepts            UserMemoryConcept[]
  personalMaterials         PersonalMaterial[]
  personalKbSessions        PersonalKbSession[]
  notifications             Notification[]
  memoryReviewPreference    UserMemoryReviewPreference?
  memoryReviewSessions      MemoryReviewSession[]

  @@map("users")
}

model Course {
  id            String       @id @default(uuid()) @db.Uuid
  teacherId     String       @map("teacher_id") @db.Uuid
  name          String       @map("name")
  description   String?      @map("description")
  coverImageUrl String?      @map("cover_image_url")
  status        CourseStatus @default(DRAFT) @map("status")
  shareCode     String?      @unique @map("share_code")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  isDeleted     Boolean      @default(false) @map("is_deleted")

  teacher         User                   @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments     CourseEnrollment[]
  lessons     Lesson[]
  materials   Material[]
  qaLogs      QaLog[]
  chatSessions CourseChatSession[]
  assignments  Assignment[]

  @@index([teacherId])
  @@map("courses")
}

model Lesson {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String   @map("title")
  description String?  @map("description")
  orderIndex  Int      @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  isDeleted   Boolean  @default(false) @map("is_deleted")

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials Material[]
  qaLogs    QaLog[]

  @@index([courseId])
  @@map("lessons")
}

model CourseEnrollment {
  id         String   @id @default(uuid()) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
  @@map("course_enrollments")
}

model Material {
  id                 String         @id @default(uuid()) @db.Uuid
  courseId           String         @map("course_id") @db.Uuid
  lessonId           String?        @map("lesson_id") @db.Uuid
  originalFilename   String         @map("original_filename")
  fileType           String         @map("file_type")
  fileSize           Int            @map("file_size")
  minioPath          String         @map("minio_path")
  previewPdfStatus   MaterialPreviewPdfStatus @default(NA) @map("preview_pdf_status")
  status             MaterialStatus @default(UPLOADED) @map("status")
  statusMessage      String?        @map("status_message")
  indexedChunkCount  Int            @default(0) @map("indexed_chunk_count")
  transcriptText    String?        @map("transcript_text") @db.Text
  videoSummary       String?        @map("video_summary") @db.Text
  documentSummary    String?        @map("document_summary") @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  isDeleted          Boolean        @default(false) @map("is_deleted")

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  images             MaterialImage[]
  chunkPageMappings  ChunkPageMapping[]

  @@index([courseId, status])
  @@map("materials")
}

model MaterialImage {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  pageIdx    Int      @map("page_idx")
  minioUrl   String   @map("minio_url")
  createdAt  DateTime @default(now()) @map("created_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("material_images")
}

/// Maps LightRAG chunk IDs to the source page they were extracted from.
/// Populated during material indexing so citation panels can show only the relevant page image.
model ChunkPageMapping {
  id         String @id @default(uuid()) @db.Uuid
  materialId String @map("material_id") @db.Uuid
  chunkId    String @map("chunk_id") @db.VarChar(255)
  pageIdx    Int    @map("page_idx")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkId])
  @@index([materialId])
  @@map("chunk_page_mappings")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// One Agent HTTP session per platform user per course (B3 isolation).
model CourseChatSession {
  id             String    @id @default(uuid()) @db.Uuid
  courseId       String    @map("course_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  agentSessionId String    @unique @map("agent_session_id") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId, studentId])
  @@index([studentId])
  @@map("course_chat_sessions")
}

/// QA center global threads (cross-course RAG); one Agent session per row.
model QaCenterSession {
  id             String    @id @default(uuid()) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  agentSessionId String    @unique @map("agent_session_id") @db.VarChar(255)
  title          String?   @map("title")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("qa_center_sessions")
}

/// Custom titles for course-scoped chat threads (keyed by agent session_id).
model ChatThreadTitleOverride {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  sessionId String   @map("session_id") @db.VarChar(255)
  title     String   @map("title")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@map("chat_thread_title_overrides")
}

model QaLog {
  id                String    @id @default(uuid()) @db.Uuid
  courseId          String?   @map("course_id") @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  lessonId          String?   @map("lesson_id") @db.Uuid
  sessionId         String    @map("session_id") @db.VarChar(255)
  question          String    @map("question")
  questionTokens    Int?      @map("question_tokens")
  answer            String?   @map("answer")
  answerTokens      Int?      @map("answer_tokens")
  totalTokens       Int?      @map("total_tokens")
  executionTimeMs   Int       @map("execution_time_ms")
  modelUsed         String    @map("model_used") @db.VarChar(100)
  hitChunks         String[]  @default([]) @map("hit_chunks")
  hitMaterials      String[]  @default([]) @map("hit_materials")
  hitSources        String[]  @default([]) @map("hit_sources")
  toolCalls         Json?     @default("[]") @map("tool_calls")
  citations         Json?     @default("[]") @map("citations")
  responseQuality   Int?      @map("response_quality") @db.SmallInt
  isHelpful         Boolean?  @map("is_helpful")
  agentFeedback     String?   @map("agent_feedback")
  metadata          Json?     @map("metadata")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  course  Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User    @relation("QaLogStudent", fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt(sort: Desc)])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@map("qa_logs")
}

/// Teacher-created assignments generated by the AI pipeline.
model Assignment {
  id              String           @id @default(uuid()) @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  createdBy       String           @map("created_by") @db.Uuid
  title           String           @map("title")
  description     String?          @map("description")
  status          AssignmentStatus @default(GENERATING) @map("status")
  errorMessage    String?          @map("error_message")

  /// Original NLP request string supplied by the teacher (stored for retry)
  teacherRequest  String?          @map("teacher_request")

  /// Structured generation params JSON supplied by the teacher (stored for retry)
  structuredParams Json?           @map("structured_params")

  /// PlannerAgent output: {title, topic_hint, difficulty, count, type_weights, objective_weights, estimated_minutes}
  blueprint     Json?            @map("blueprint")

  /// Array of question objects: [{id, type, objective, entity, question, options, answer, explanation, score, ...}]
  questions     Json?            @map("questions")

  /// ReviewerAgent output: {overall_score, passed, threshold, question_reviews, failed_ids, summary}
  qualityReport Json?            @map("quality_report")

  /// Current generation pipeline phase: param_extract | entity_retrieval | blueprint_gen | question_gen | reviewing | improving
  generationPhase String?        @map("generation_phase")

  deadline      DateTime?        @map("deadline")
  publishedAt   DateTime?        @map("published_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdByUser User @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  submissions   AssignmentSubmission[]

  @@index([courseId, status])
  @@index([courseId, createdAt(sort: Desc)])
  @@map("assignments")
}

/// Student submission for a published assignment.
model AssignmentSubmission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid

  /// [{questionId: number, answer: string}]
  answers      Json             @map("answers")

  status       SubmissionStatus @default(SUBMITTED) @map("status")

  /// {totalScore, maxScore, questionGrades: [{questionId, score, maxScore, isCorrect, feedback, source}]}
  gradingResult Json?           @map("grading_result")

  teacherFeedback String?       @map("teacher_feedback")

  submittedAt  DateTime         @default(now()) @map("submitted_at")
  gradedAt     DateTime?        @map("graded_at")
  returnedAt   DateTime?        @map("returned_at")

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model UserLearningProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  profile   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_learning_profiles")
}

model UserMemoryFact {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sessionId  String   @map("session_id")
  timestamp  DateTime @default(now())
  category   String
  content    String
  confidence Float
  sourceJson Json     @map("source_json")
  metadata   Json     @default("{}")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([userId, sessionId])
  @@map("user_memory_facts")
}

model UserMemoryConcept {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  name              String
  description       String   @default("")
  masteryLevel      Float    @default(0) @map("mastery_level")
  lastUpdated       DateTime @updatedAt @map("last_updated")
  supportingFactIds String[] @map("supporting_fact_ids")
  relatedConcepts   String[] @map("related_concepts")
  metadata          Json     @default("{}")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, name])
  @@index([userId])
  @@map("user_memory_concepts")
}

// ---------------------------------------------------------------------------
// Personal Knowledge Base
// ---------------------------------------------------------------------------

model PersonalMaterial {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  originalFilename  String                   @map("original_filename")
  fileType          String                   @map("file_type")
  fileSize          Int                      @map("file_size")
  minioPath         String                   @map("minio_path")
  previewPdfStatus  MaterialPreviewPdfStatus @default(NA) @map("preview_pdf_status")
  status            MaterialStatus           @default(UPLOADED) @map("status")
  statusMessage     String?                  @map("status_message")
  indexedChunkCount Int                      @default(0) @map("indexed_chunk_count")
  transcriptText    String?                  @map("transcript_text") @db.Text
  videoSummary      String?                  @map("video_summary") @db.Text
  documentSummary   String?                  @map("document_summary") @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  isDeleted         Boolean                  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("personal_materials")
}

/// One personal-KB chat session per user (lazy-created on first visit).
model PersonalKbSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  agentSessionId String   @unique @map("agent_session_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_kb_sessions")
}

// ---------------------------------------------------------------------------
// Daily Memory Review
// ---------------------------------------------------------------------------

/// Per-user preference for daily memory review scheduling.
model UserMemoryReviewPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  enabled   Boolean  @default(true)
  /// Local time in "HH:mm" format, e.g. "09:00"
  localTime String   @default("09:00") @map("local_time") @db.VarChar(5)
  /// IANA timezone string, e.g. "Asia/Shanghai"
  timezone  String   @default("Asia/Shanghai") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_memory_review_preferences")
}

/// One review batch per user per local calendar day.
model MemoryReviewSession {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  /// User's local date string "YYYY-MM-DD" — uniqueness prevents duplicate daily sessions.
  scheduledDate String                    @map("scheduled_date") @db.VarChar(10)
  status        MemoryReviewSessionStatus @default(PENDING)
  questionCount Int                       @default(0) @map("question_count")
  expiresAt     DateTime                  @map("expires_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions MemoryReviewQuestion[]

  @@unique([userId, scheduledDate])
  @@index([userId, status])
  @@map("memory_review_sessions")
}

/// A single question within a daily review session.
model MemoryReviewQuestion {
  id          String                   @id @default(uuid()) @db.Uuid
  sessionId   String                   @map("session_id") @db.Uuid
  /// Optional FK to course the question is derived from
  courseId    String?                  @map("course_id") @db.Uuid
  /// Optional FK to the UserMemoryConcept being tested
  conceptId   String?                  @map("concept_id") @db.Uuid
  conceptName String                   @map("concept_name")
  type        MemoryReviewQuestionType
  stem        String                   @db.Text
  /// JSON array of option strings (required for SINGLE_CHOICE and TRUE_FALSE)
  optionsJson Json?                    @map("options_json")
  /// Correct answer string
  answer      String
  explanation String                   @db.Text
  userAnswer  String?                  @map("user_answer")
  isCorrect   Boolean?                 @map("is_correct")
  answeredAt  DateTime?                @map("answered_at")
  createdAt   DateTime                 @default(now()) @map("created_at")

  session MemoryReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("memory_review_questions")
}

// ---------------------------------------------------------------------------
// Agent Style Management
// ---------------------------------------------------------------------------

/// Admin-managed teaching style definitions injected into the Agent's system prompt.
/// Replaces the file-based EDUCATOR/scaffolding/socratic skills for purely prompt-based styles.
model AgentStyle {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(50)
  description  String   @default("") @db.VarChar(200)
  body         String   @db.Text
  alwaysInject Boolean  @default(false) @map("always_inject")
  enabled      Boolean  @default(true)
  /// Built-in styles (seeded from md files) can be edited/disabled but not deleted.
  isBuiltIn    Boolean  @default(false) @map("is_built_in")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("agent_styles")
}

/// Persistent in-app notifications delivered via Redis Pub/Sub + SSE.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @map("type")
  title     String           @map("title")
  body      String           @map("body")
  metadata  Json?            @map("metadata")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}
